{
  "name": "abumrium",
  "version": "0.1.0",
  "description": "A Chromium-based browser for developers. Chromium, but for builders.",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node ./node_modules/electron-vite/bin/electron-vite.js dev",
    "build": "node ./node_modules/electron-vite/bin/electron-vite.js build",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.json && node ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.node.json",
    "lint": "node ./node_modules/eslint/bin/eslint.js src/ --ext .ts,.tsx",
    "start": "node ./node_modules/electron-vite/bin/electron-vite.js preview",
    "package": "npm run build && node ./node_modules/electron-builder/cli.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@uiw/react-codemirror": "^4.23.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "@vitejs/plugin-react": "^4.3.4"
  },
  "build": {
    "appId": "com.abumrium.browser",
    "productName": "Abumrium",
    "directories": { "output": "release" },
    "files": ["out/**/*", "resources/**/*"],
    "linux": { "target": ["AppImage", "deb"], "category": "Network" },
    "mac": { "target": "dmg" },
    "win": { "target": "nsis" }
  }
}
